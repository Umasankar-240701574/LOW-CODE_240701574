		form Farm_Plot
		{
			displayname = "Farm Plot"
			success message = "Farm Plot Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Plot_Name
			(
    			type = text
				displayname = "Plot Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Farmer
			(
				type = picklist	
				values  = Farmer.ID
    			displayformat = [" " + Farmer_Name.prefix + " " + Farmer_Name.first_name + " " + Farmer_Name.last_name + " " + Farmer_Name.suffix]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Soil_Type
			(
				type = list	
				displayname = "Soil Type"
				values  = Soil_Type.ID
    			displayformat = [Soil_Name]
				sortorder = ascending
				height = 60px
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Plot_Area
			(
				type = decimal
				displayname = "Plot Area"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Soil_PH
			(
				type = decimal
				displayname = "Soil PH"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Water_Availability
			(
				type = picklist
				displayname = "Water Availability"
				maxchar = 100
				values = {"High","Medium","Low"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Irrigation_Source
			(
				type = picklist
				displayname = "Irrigation Source"
				maxchar = 100
				values = {"Borewell","Canal","Tank","Rainfed","Drip"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Latitude
			(
				type = decimal
				decimalplace = 6
	 			row = 1
