		form Officer_Advice
		{
			displayname = "Officer Advice"
			success message = "Officer Advice Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Advice_ID
			(
    			type = autonumber
				displayname = "Advice ID"
				start index = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Advice_Source
			(
				type = picklist
				displayname = "Advice Source"
				maxchar = 100
				values = {"Pest / Disease Report","Farmer Request"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Pest_Disease_Report
			(
				type = picklist	
				displayname = "Pest Disease Report"
				values  = Pest_Disease_Report.ID
    			displayformat = [Report_ID]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Farmer_Request
			(
				type = picklist	
				displayname = "Farmer Request"
				values  = Farmer_Request.ID
    			displayformat = [Request_Id]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Farmer
			(
				type = picklist	
				values  = Farmer.ID
    			displayformat = [" " + Farmer_Name.prefix + " " + Farmer_Name.first_name + " " + Farmer_Name.last_name + " " + Farmer_Name.suffix]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Officer_Name
			(
    			type = text
				displayname = "Officer Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Advice_Date
			(
    			type = date
				displayname = "Advice Date"
				initial value = "${zoho.currentdate}"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Diagonsis
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Advice
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Follow_up_Required
			(
				type = picklist
				displayname = "Follow up Required"
				maxchar = 100
				values = {"Yes","No"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Follow_up_Date
			(
    			type = date
				displayname = "Follow up Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Farmer_Feedback
			(
				type = picklist
				displayname = "Farmer Feedback"
				maxchar = 100
				values = {"Helpful","Partly Helpful","Not Helpful"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Action_Items
			(
				type = grid
				displayname = "Action Items"
				must have Action_field
				(
    				type = text
					displayname = "Action"
					width = medium
				)
				Product
				(
    				type = text
					width = medium
				)
				Dosage
				(
    				type = text
					width = medium
				)
				Timing
				(
    				type = text
					width = medium
				)
	 			row = 2
	 			column = 1   
				width = medium
			)
	
			actions
