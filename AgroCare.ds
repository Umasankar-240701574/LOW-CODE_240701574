 application "AgroCare"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "Asia/Kolkata"
 	time format = "24-hr"

 	forms
	{
		form Alert
		{
			success message = "Alert Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Alert_ID
			(
    			type = autonumber
				displayname = "Alert ID"
				start index = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Farmer
			(
				type = picklist	
				values  = Farmer.ID
    			displayformat = [" " + Farmer_Name.prefix + " " + Farmer_Name.first_name + " " + Farmer_Name.last_name + " " + Farmer_Name.suffix]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Plot
			(
				type = picklist	
				values  = Farm_Plot.ID
    			displayformat = [Plot_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Crop_Plan
			(
				type = picklist	
				displayname = "Crop Plan"
				values  = Crop_Plan.ID
    			displayformat = [Plan_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Disease
			(
				type = picklist	
				values  = Disease_Master.ID
    			displayformat = [Disease_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Alert_Type
			(
				type = picklist
				displayname = "Alert Type"
				maxchar = 100
				values = {"Weather","Disease Risk","Irrigation","Low Stock","General"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Severity
			(
				type = picklist
				displayname = "Severity "
				maxchar = 100
				values = {"Info","Warning","Critical"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Title
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			Temperature
			(
				type = decimal
				displayname = "Temperature "
	 			row = 1
	 			column = 1   
				width = medium
			)
			Humidity
			(
				type = decimal
	 			row = 1
	 			column = 1   
				width = medium
			)
			Message
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Alert_Date
			(
    			type = datetime
				displayname = "Alert Date"
				initial value = "${zoho.currenttime}"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Risk_Level
			(
				type = picklist
				displayname = "Risk Level"
				maxchar = 100
				values = {"Low","Medium","High"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Sent_Via
			(
				type = picklist
				displayname = "Sent Via"
				maxchar = 100
				values = {"App","Email","SMS"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Read_Status
			(
				type = picklist
				displayname = "Read Status"
				maxchar = 100
				values = {"Unread","Read"}
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Crop
		{
			success message = "Crop Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have unique Crop_Name
			(
    			type = text
				displayname = "Crop Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Season
			(
				type = picklist
				maxchar = 100
				values = {"Kharif","Rabi","Zaid"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Min_PH
			(
				type = decimal
				displayname = "Min PH"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Max_PH
			(
				type = decimal
				displayname = "Max PH"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Water_Need
			(
				type = picklist
				displayname = "Water Need"
				maxchar = 100
				values = {"Low","Medium","High"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Suitable_Soils
			(
				type = list	
				displayname = "Suitable Soils"
				values  = Soil_Type.ID
    			displayformat = [Soil_Name]
				sortorder = ascending
				height = 60px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Duration_Days
			(
				type = number
				displayname = "Duration(Days)"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Description
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Crop_Guide
		{
			displayname = "Crop Guide"
			success message = "Crop Guide Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Crop
			(
				type = picklist	
