	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Sowing_Steps
			(
    			type = textarea
				displayname = "Sowing Steps"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Irrigation_Guide
			(
    			type = textarea
				displayname = "Irrigation Guide"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Fertilizer_Schedule
			(
    			type = textarea
				displayname = "Fertilizer Schedule"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Pest_Management
			(
    			type = textarea
				displayname = "Pest Management"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Harvesting
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Crop_Health_Log
		{
			displayname = "Crop Health Log"
			success message = "Crop Health Log Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Log_ID
			(
    			type = autonumber
				displayname = "Log ID"
				start index = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Crop_Plan
			(
				type = picklist	
				displayname = "Crop Plan"
				values  = Crop_Plan.ID
    			displayformat = [Plan_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Farmer
			(
				type = picklist	
				values  = Farmer.ID
    			displayformat = [" " + Farmer_Name.prefix + " " + Farmer_Name.first_name + " " + Farmer_Name.last_name + " " + Farmer_Name.suffix]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Log_Date
			(
    			type = date
				displayname = "Log Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Growth_Stage
			(
				type = picklist
				displayname = "Growth Stage"
				maxchar = 100
				values = {"Germination","Vegetative","Flowering","Fruiting","Maturity"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Health_Status
			(
				type = picklist
				displayname = "Health Status"
				maxchar = 100
				values = {"Excellent","Good","Fair","Poor","Critical"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Plant_Height
			(
				type = decimal
				displayname = "Plant Height"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Leaf_Colour
			(
				type = picklist
				displayname = "Leaf Colour"
				maxchar = 100
				values = {"Green","Yellowing","Browning","Spotted"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Photo
			(
    			type = image
				source  = file
				aspect ratio = original
				camera = primary
				show gallery = true
				switch camera = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Remarks
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
