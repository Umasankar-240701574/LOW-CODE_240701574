	reports
	{
		default list All_Soil_Types
		{
			displayName = "All Soil Types"
			show all rows from Soil_Type    
			(
				Soil_Name as "Soil Name"
				Min_PH as "Min PH"
				Max_PH as "Max PH"
				Water_Retention as "Water Retention"
				Description
			)
		}
		default list All_Crops
		{
			displayName = "All Crops"
			show all rows from Crop    
			(
				Crop_Name as "Crop Name"
				Season
				Min_PH as "Min PH"
				Max_PH as "Max PH"
				Water_Need as "Water Need"
				Suitable_Soils as "Suitable Soils"
				Duration_Days as "Duration(Days)"
				Description
			)
