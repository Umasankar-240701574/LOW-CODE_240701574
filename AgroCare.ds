	pages
	{
		page Farmer_Dashboard
		{
			displayname = "Farmer Dashboard"
			Content="<zml    \t\t\n\t\t\n\t\t\n\t\t\n\t\t\n>\n\t<layout>\n\t<row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<dsp id='html_snippet2' elementName='HTML Snippet'\n bgColor=\"#FFFFFF\" \n>\n\t<![CDATA[htmlpage html_snippet2()\ncontent\n&lt;%{\n\tme = Farmer[Login_Email == zoho.loginuserid];\n\tmyId = 0;\n\tmyName = &quot;Farmer&quot;;\n\tfor each  f in me\n\t{\n\t\tmyId = f.ID;\n\t\tmyName = f.Farmer_Name;\n\t}\n\tactiveCrops = Crop_Plan[Farmer == myId &amp;&amp; Status == &quot;Sown&quot; || Status == &quot;Growing&quot;].count();\n\topenRequests = Farmer_Request[Farmer == myId &amp;&amp; Status == &quot;Pending&quot;].count();\n\topenCases = Pest_Disease_Report[Farmer == myId &amp;&amp; Status != &quot;Resolved&quot;].count();\n\tmyAlerts = Alert[Farmer == myId &amp;&amp; Read_Status == &quot;Unread&quot;].count();\n\tavgHealth = 0;\n\tplanCount = 0;\n\tfor each  p in Crop_Plan[Farmer == myId]\n\t{\n\t\tif(p.Health_Score != null)\n\t\t{\n\t\t\tavgHealth = avgHealth + p.Health_Score;\n\t\t\tplanCount = planCount + 1;\n\t\t}\n\t}\n\tif(planCount &gt; 0)\n\t{\n\t\tavgHealth = avgHealth / planCount;\n\t}\n\t%&gt;\n&lt;style&gt;\n  .ag-wrap{font-family:&apos;Segoe UI&apos;,Arial,sans-serif;padding:8px 4px}\n  .ag-hero{background:linear-gradient(135deg,#1b5e20,#7cb342);color:#fff;border-radius:14px;padding:22px 26px;margin-bottom:18px;box-shadow:0 4px 14px rgba(27,94,32,.25)}\n  .ag-hero h1{margin:0;font-size:26px}\n  .ag-hero p{margin:6px 0 0;opacity:.9;font-size:14px}\n  .ag-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:14px}\n  .ag-card{background:#fff;border-radius:12px;padding:16px 18px;border-left:5px solid #43a047;box-shadow:0 2px 8px rgba(0,0,0,.08)}\n  .ag-num{font-size:30px;font-weight:700;color:#1b5e20;line-height:1.1}\n  .ag-lbl{font-size:13px;color:#607d8b;margin-top:4px;text-transform:uppercase;letter-spacing:.6px}\n  .ag-card.warn{border-left-color:#f9a825}.ag-card.warn .ag-num{color:#e65100}\n  .ag-card.bad{border-left-color:#e53935}.ag-card.bad .ag-num{color:#c62828}\n&lt;/style&gt;\n\n&lt;div class=&quot;ag-wrap&quot;&gt;\n  &lt;div class=&quot;ag-hero&quot;&gt;\n    &lt;h1&gt;Welcome, &lt;%=myName%&gt;&lt;/h1&gt;\n    &lt;p&gt;Your crops, health score, alerts and requests at a glance&lt;/p&gt;\n  &lt;/div&gt;\n  &lt;div class=&quot;ag-grid&quot;&gt;\n    &lt;div class=&quot;ag-card&quot;&gt;&lt;div class=&quot;ag-num&quot;&gt;&lt;%=activeCrops%&gt;&lt;/div&gt;&lt;div class=&quot;ag-lbl&quot;&gt;Active Crops&lt;/div&gt;&lt;/div&gt;\n    &lt;div class=&quot;ag-card&quot;&gt;&lt;div class=&quot;ag-num&quot;&gt;&lt;%=avgHealth%&gt;/100&lt;/div&gt;&lt;div class=&quot;ag-lbl&quot;&gt;Avg Health Score&lt;/div&gt;&lt;/div&gt;\n    &lt;div class=&quot;ag-card bad&quot;&gt;&lt;div class=&quot;ag-num&quot;&gt;&lt;%=myAlerts%&gt;&lt;/div&gt;&lt;div class=&quot;ag-lbl&quot;&gt;Unread Alerts&lt;/div&gt;&lt;/div&gt;\n    &lt;div class=&quot;ag-card warn&quot;&gt;&lt;div class=&quot;ag-num&quot;&gt;&lt;%=openRequests%&gt;&lt;/div&gt;&lt;div class=&quot;ag-lbl&quot;&gt;Pending Requests&lt;/div&gt;&lt;/div&gt;\n    &lt;div class=&quot;ag-card warn&quot;&gt;&lt;div class=&quot;ag-num&quot;&gt;&lt;%=openCases%&gt;&lt;/div&gt;&lt;div class=&quot;ag-lbl&quot;&gt;Open Problems&lt;/div&gt;&lt;/div&gt;\n  &lt;/div&gt;\n&lt;/div&gt;\n&lt;%\n\n}%&gt;]]>\n</dsp>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<report \n\telementName='Report'\n\n\t\n\ttitle = '&quot;My Farm Dashboard&quot;'\n\t\n\t\ttitleColor = '#222326'\n\t\tappLinkName = 'thisapp'\n\t\tlinkName = 'My_Alerts'\n\t\n\t\tiszreport = 'false'\n\theightType = 'auto'\n\theightValue = '700'\n/>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<report \n\telementName='Report 1'\n\n\t\tappLinkName = 'thisapp'\n\t\tlinkName = 'Requests_by_Status'\n\t\n\t\tiszreport = 'false'\n\theightType = 'auto'\n\theightValue = '700'\n/>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<report \n\telementName='Report 2'\n\n\t\tappLinkName = 'thisapp'\n\t\tlinkName = 'Crop_wise_Area'\n\t\n\t\tiszreport = 'true'\n\theightType = 'auto'\n\theightValue = '700'\n/>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<report \n\telementName='Report 3'\n\n\t\tappLinkName = 'thisapp'\n\t\tlinkName = 'Crop_Health_Trend'\n\t\n\t\tiszreport = 'true'\n\theightType = 'auto'\n\theightValue = '700'\n/>\n</column>\n</row>\n</layout>\n</zml>"
		}
		page Officer_Dashboard
		{
			displayname = "Officer Dashboard"
			Content="<zml    \t\t\n\t\t\n\t\t\n\t\t\n\t\t\n>\n\t<layout>\n\t<row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<dsp id='html_snippet1' elementName='HTML Snippet'\n bgColor=\"#FFFFFF\" \n>\n\t<![CDATA[htmlpage html_snippet1()\ncontent\n&lt;%{\n\tnewCases = Pest_Disease_Report[Status == &quot;Submitted&quot;].count();\n\treviewCases = Pest_Disease_Report[Status == &quot;Under Review&quot;].count();\n\tadvisedCases = Pest_Disease_Report[Status == &quot;Advisory Given&quot;].count();\n\tmonitoring = Pest_Disease_Report[Status == &quot;Monitoring&quot;].count();\n\tresolved = Pest_Disease_Report[Status == &quot;Resolved&quot;].count();\n\thighRisk = Alert[Risk_Level == &quot;High&quot;].count();\n\t%&gt;\n&lt;style&gt;\n  .ag-wrap{font-family:&apos;Segoe UI&apos;,Arial,sans-serif;padding:8px 4px}\n  .ag-hero{background:linear-gradient(135deg,#0d47a1,#1e88e5);color:#fff;border-radius:14px;padding:22px 26px;margin-bottom:18px;box-shadow:0 4px 14px rgba(13,71,161,.25)}\n  .ag-hero h1{margin:0;font-size:26px}\n  .ag-hero p{margin:6px 0 0;opacity:.9;font-size:14px}\n  .ag-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:14px}\n  .ag-card{background:#fff;border-radius:12px;padding:16px 18px;border-left:5px solid #1e88e5;box-shadow:0 2px 8px rgba(0,0,0,.08)}\n  .ag-num{font-size:30px;font-weight:700;color:#0d47a1;line-height:1.1}\n  .ag-lbl{font-size:13px;color:#607d8b;margin-top:4px;text-transform:uppercase;letter-spacing:.6px}\n  .ag-card.warn{border-left-color:#f9a825}.ag-card.warn .ag-num{color:#e65100}\n  .ag-card.bad{border-left-color:#e53935}.ag-card.bad .ag-num{color:#c62828}\n  .ag-card.ok{border-left-color:#43a047}.ag-card.ok .ag-num{color:#1b5e20}\n&lt;/style&gt;\n\n&lt;div class=&quot;ag-wrap&quot;&gt;\n  &lt;div class=&quot;ag-hero&quot;&gt;\n    &lt;h1&gt;Agricultural Officer Dashboard&lt;/h1&gt;\n    &lt;p&gt;New cases, high-risk alerts and case progress at a glance&lt;/p&gt;\n  &lt;/div&gt;\n  &lt;div class=&quot;ag-grid&quot;&gt;\n    &lt;div class=&quot;ag-card bad&quot;&gt;&lt;div class=&quot;ag-num&quot;&gt;&lt;%=newCases%&gt;&lt;/div&gt;&lt;div class=&quot;ag-lbl&quot;&gt;New Cases&lt;/div&gt;&lt;/div&gt;\n    &lt;div class=&quot;ag-card warn&quot;&gt;&lt;div class=&quot;ag-num&quot;&gt;&lt;%=reviewCases%&gt;&lt;/div&gt;&lt;div class=&quot;ag-lbl&quot;&gt;Under Review&lt;/div&gt;&lt;/div&gt;\n    &lt;div class=&quot;ag-card&quot;&gt;&lt;div class=&quot;ag-num&quot;&gt;&lt;%=advisedCases%&gt;&lt;/div&gt;&lt;div class=&quot;ag-lbl&quot;&gt;Advisory Given&lt;/div&gt;&lt;/div&gt;\n    &lt;div class=&quot;ag-card&quot;&gt;&lt;div class=&quot;ag-num&quot;&gt;&lt;%=monitoring%&gt;&lt;/div&gt;&lt;div class=&quot;ag-lbl&quot;&gt;Monitoring&lt;/div&gt;&lt;/div&gt;\n    &lt;div class=&quot;ag-card bad&quot;&gt;&lt;div class=&quot;ag-num&quot;&gt;&lt;%=highRisk%&gt;&lt;/div&gt;&lt;div class=&quot;ag-lbl&quot;&gt;High-Risk Alerts&lt;/div&gt;&lt;/div&gt;\n    &lt;div class=&quot;ag-card ok&quot;&gt;&lt;div class=&quot;ag-num&quot;&gt;&lt;%=resolved%&gt;&lt;/div&gt;&lt;div class=&quot;ag-lbl&quot;&gt;Resolved&lt;/div&gt;&lt;/div&gt;\n  &lt;/div&gt;\n&lt;/div&gt;\n&lt;%\n\n}%&gt;]]>\n</dsp>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<report \n\telementName='Report'\n\n\t\tappLinkName = 'thisapp'\n\t\tlinkName = 'Open_Reports'\n\t\n\t\tiszreport = 'false'\n\theightType = 'auto'\n\theightValue = '700'\n/>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<report \n\telementName='Report 1'\n\n\t\tappLinkName = 'thisapp'\n\t\tlinkName = 'Case_Board'\n\t\n\t\tiszreport = 'false'\n\theightType = 'auto'\n\theightValue = '700'\n/>\n</column>\n</row><row>\n\t<column\n   \t\t width='50%'\n   \t>\n\t<report \n\telementName='Report 2'\n\n\t\tappLinkName = 'thisapp'\n\t\tlinkName = 'Cases_by_Category'\n\t\n\t\tiszreport = 'true'\n\theightType = 'auto'\n\theightValue = '700'\n/>\n</column><column\n   \t\t width='50%'\n   \t>\n\t<report \n\telementName='Report 3'\n\n\t\tappLinkName = 'thisapp'\n\t\tlinkName = 'Farmer_wise_Issues'\n\t\n\t\tiszreport = 'true'\n\theightType = 'auto'\n\theightValue = '700'\n/>\n</column>\n</row>\n</layout>\n</zml>"
		}
		page Admin_Dashboard
		{
			displayname = "Admin Dashboard"
			Content="<zml    \t\t\n\t\t\n\t\t\n\t\t\n\t\t\n>\n\t<layout>\n\t<row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<dsp id='html_snippet' elementName='HTML Snippet'\n bgColor=\"#FFFFFF\" \n>\n\t<![CDATA[htmlpage html_snippet()\ncontent\n&lt;%{\n\ttotalFarmers = Farmer[ID != 0].count();\n\ttotalPlots = Farm_Plot[ID != 0].count();\n\tactivePlans = Crop_Plan[Status == &quot;Sown&quot; || Status == &quot;Growing&quot;].count();\n\topenCases = Pest_Disease_Report[Status != &quot;Resolved&quot;].count();\n\tpendingReqs = Farmer_Request[Status == &quot;Pending&quot;].count();\n\tlowStock = 0;\n\tfor each  inv in Inventory[ID != 0]\n\t{\n\t\tif(inv.Current_Stock &lt;= inv.Reorder_Level)\n\t\t{\n\t\t\tlowStock = lowStock + 1;\n\t\t}\n\t}\n\t%&gt;\n&lt;style&gt;\n  .ag-wrap{font-family:&apos;Segoe UI&apos;,Arial,sans-serif;padding:8px 4px}\n  .ag-hero{background:linear-gradient(135deg,#1b5e20,#43a047);color:#fff;border-radius:14px;padding:22px 26px;margin-bottom:18px;box-shadow:0 4px 14px rgba(27,94,32,.25)}\n  .ag-hero h1{margin:0;font-size:26px}\n  .ag-hero p{margin:6px 0 0;opacity:.9;font-size:14px}\n  .ag-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:14px}\n  .ag-card{background:#fff;border-radius:12px;padding:16px 18px;border-left:5px solid #43a047;box-shadow:0 2px 8px rgba(0,0,0,.08)}\n  .ag-num{font-size:30px;font-weight:700;color:#1b5e20;line-height:1.1}\n  .ag-lbl{font-size:13px;color:#607d8b;margin-top:4px;text-transform:uppercase;letter-spacing:.6px}\n  .ag-card.warn{border-left-color:#f9a825}.ag-card.warn .ag-num{color:#e65100}\n  .ag-card.bad{border-left-color:#e53935}.ag-card.bad .ag-num{color:#c62828}\n&lt;/style&gt;\n\n&lt;div class=&quot;ag-wrap&quot;&gt;\n  &lt;div class=&quot;ag-hero&quot;&gt;\n    &lt;h1&gt;AgroCare Admin Dashboard&lt;/h1&gt;\n    &lt;p&gt;Farms, crops, disease cases, requests and stock at a glance&lt;/p&gt;\n  &lt;/div&gt;\n  &lt;div class=&quot;ag-grid&quot;&gt;\n    &lt;div class=&quot;ag-card&quot;&gt;&lt;div class=&quot;ag-num&quot;&gt;&lt;%=totalFarmers%&gt;&lt;/div&gt;&lt;div class=&quot;ag-lbl&quot;&gt;Farmers&lt;/div&gt;&lt;/div&gt;\n    &lt;div class=&quot;ag-card&quot;&gt;&lt;div class=&quot;ag-num&quot;&gt;&lt;%=totalPlots%&gt;&lt;/div&gt;&lt;div class=&quot;ag-lbl&quot;&gt;Farm Plots&lt;/div&gt;&lt;/div&gt;\n    &lt;div class=&quot;ag-card&quot;&gt;&lt;div class=&quot;ag-num&quot;&gt;&lt;%=activePlans%&gt;&lt;/div&gt;&lt;div class=&quot;ag-lbl&quot;&gt;Active Crops&lt;/div&gt;&lt;/div&gt;\n    &lt;div class=&quot;ag-card warn&quot;&gt;&lt;div class=&quot;ag-num&quot;&gt;&lt;%=pendingReqs%&gt;&lt;/div&gt;&lt;div class=&quot;ag-lbl&quot;&gt;Pending Requests&lt;/div&gt;&lt;/div&gt;\n    &lt;div class=&quot;ag-card bad&quot;&gt;&lt;div class=&quot;ag-num&quot;&gt;&lt;%=openCases%&gt;&lt;/div&gt;&lt;div class=&quot;ag-lbl&quot;&gt;Open Cases&lt;/div&gt;&lt;/div&gt;\n    &lt;div class=&quot;ag-card warn&quot;&gt;&lt;div class=&quot;ag-num&quot;&gt;&lt;%=lowStock%&gt;&lt;/div&gt;&lt;div class=&quot;ag-lbl&quot;&gt;Low Stock Items&lt;/div&gt;&lt;/div&gt;\n  &lt;/div&gt;\n&lt;/div&gt;\n&lt;%\n\n}%&gt;]]>\n</dsp>\n</column>\n</row><row>\n\t<column\n   \t\t width='50%'\n   \t>\n\t<report \n\telementName='Report'\n\n\t\tappLinkName = 'thisapp'\n\t\tlinkName = 'Crop_wise_Area'\n\t\n\t\tiszreport = 'true'\n\theightType = 'auto'\n\theightValue = '700'\n/>\n</column><column\n   \t\t width='50%'\n   \t>\n\t<report \n\telementName='Report 1'\n\n\t\tappLinkName = 'thisapp'\n\t\tlinkName = 'Stock_Levels'\n\t\n\t\tiszreport = 'true'\n\theightType = 'auto'\n\theightValue = '700'\n/>\n</column>\n</row><row>\n\t<column\n   \t\t width='50%'\n   \t>\n\t<report \n\telementName='Report 2'\n\n\t\tappLinkName = 'thisapp'\n\t\tlinkName = 'Montly_Request'\n\t\n\t\tiszreport = 'true'\n\theightType = 'auto'\n\theightValue = '700'\n/>\n</column><column\n   \t\t width='50%'\n   \t>\n\t<report \n\telementName='Report 3'\n\n\t\tappLinkName = 'thisapp'\n\t\tlinkName = 'Fertilizer_Usage_Chart'\n\t\n\t\tiszreport = 'true'\n\theightType = 'auto'\n\theightValue = '700'\n/>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<report \n\telementName='Report 4'\n\n\t\tappLinkName = 'thisapp'\n\t\tlinkName = 'Cases_by_Category'\n\t\n\t\tiszreport = 'true'\n\theightType = 'auto'\n\theightValue = '700'\n/>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<report \n\telementName='Report 5'\n\n\t\tappLinkName = 'thisapp'\n\t\tlinkName = 'Low_Stock_Items'\n\t\n\t\tiszreport = 'false'\n\theightType = 'auto'\n\theightValue = '700'\n/>\n</column>\n</row>\n</layout>\n</zml>"
		}
	}




		workflow
		{
		form
		{
			Fill_Plan_Name as "Fill Plan Name"
			{
				type =  form
				form = Crop_Plan

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											plot = Farm_Plot[ID == input.Plot];
										crop = Crop[ID == input.Crop];
										input.Crop_Name = crop.Crop_Name;
										rec = Crop_Plan[ID == input.ID];
										rec.Plan_Name=plot.Plot_Name + " - " + crop.Crop_Name + " - " + input.Season;
										rec.Farmer=plot.Farmer;
						)
					}
				}

			}
			Calculate_Harvest_Date as "Calculate Harvest Date"
			{
				type =  form
				form = Crop_Plan

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											crop = Crop[ID == input.Crop];
										if(crop.Duration_Days != null && input.Sowing_Date != null)
										{
											Expected_Harvest_Date = input.Sowing_Date.addDay(crop.Duration_Days);
										}
						)
					}
				}

			}
			Fill_Farmer_in_Health_Log as "Fill Farmer in Health Log"
			{
				type =  form
				form = Crop_Health_Log

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											plan = Crop_Plan[ID == input.Crop_Plan];
										if(plan.Farmer != null)
										{
											input.Farmer = plan.Farmer;
										}
						)
					}
				}

			}
			Fill_Farmer_Irrigation_Lo as "Fill Farmer Irrigation Log"
			{
				type =  form
				form = Irrigation_Log

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											plan = Crop_Plan[ID == input.Crop_Plan];
										if(plan.Farmer != null)
										{
											input.Farmer = plan.Farmer;
										}
						)
					}
				}

			}
			Fertilizer_Usage_Calculat as "Fertilizer Usage Calculations"
			{
				type =  form
				form = Fertilizer_Usage

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// 1. Copy the farmer from the crop plan
										plan = Crop_Plan[ID == input.Crop_Plan];
										if(plan.Farmer != null)
										{
											input.Farmer = plan.Farmer;
										}
										// 2. Fill price and cost for each subform row, and add up the total
										total = 0.0;
										for each  row in input.Fertilizers_Applied
										{
											fert = Fertilizer_Master[ID == row.Fertilizer];
											price = fert.Price_per_Unit;
											row.Unit_Price=price.toString();
											row.Cost=row.Quantity * price;
											total = total + row.Quantity * price;
										}
										// 3. Save the grand total on the main form
										input.Total_Cost = total;
						)
					}
				}

			}
			Request_Calculations as "Request Calculations"
			{
				type =  form
				form = Farmer_Request

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											total = 0.0;
										for each  row in input.Request_Items
										{
											price = 0.0;
											if(row.Item_Type == "Seed" && row.Seed != null)
											{
												seedRec = Seed_Master[ID == row.Seed];
												price = seedRec.Price_per_Unit;
											}
											else if(row.Item_Type == "Fertilizer" && row.Fertilizer != null)
											{
												fertRec = Fertilizer_Master[ID == row.Fertilizer];
												price = fertRec.Price_per_Unit;
											}
											row.Unit_Price=price;
											row.Line_Total=row.Quantity * price;
											total = total + row.Quantity * price;
										}
										input.Total_Amount = total;
										// suggest inputs for the selected crop and stage
										if(input.Crop_Plan != null && input.Crop_Stage != null)
										{
											cp = Crop_Plan[ID == input.Crop_Plan];
											tips = "";
											for each  s in Seed_Master[Crop == cp.Crop]
											{
												tips = tips + "Seed: " + s.Seed_Name + "\n";
											}
											for each  fm in Fertilizer_Master[Suitable_Stage == input.Crop_Stage]
											{
												tips = tips + "Fertilizer: " + fm.Fertilizer_Name + "\n";
											}
											input.Suggested_Inputs = tips;
										}
						)
					}
				}

			}
			Pest_Report_Setup as "Pest Report Setup"
			{
				type =  form
				form = Pest_Disease_Report

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											plan = Crop_Plan[ID == input.Crop_Plan];
										farmerRec = Farmer[ID == plan.Farmer];
										// pick an officer by the farmer's village, otherwise any officer
										officerList = Officer[Village_Covered == farmerRec.Village];
										if(officerList.count() == 0)
										{
											officerList = Officer[ID != 0];
										}
										officerName = "";
										officerEmail = "";
										for each  off in officerList
										{
											if(officerName == "")
											{
												officerName = off.Officer_Name;
												officerEmail = off.Email;
											}
										}
										// update the saved report
										rep = Pest_Disease_Report[ID == input.ID];
										rep.Farmer=plan.Farmer;
										rep.Assigned_Officer=officerName;
										rep.Status="Under Review";
										// email the officer
										if(officerEmail != "")
										{
											sendmail
											[
												from :zoho.adminuserid
												to :officerEmail
												subject :"New pest/disease report: " + plan.Plan_Name
												message :"Severity: " + input.Severity + "<br>Symptoms: " + input.Symptoms + "<br>Farmer: " + farmerRec.Farmer_Name + ", " + farmerRec.Village
											]
										}
										payload = Map();
										payload.put("text","New " + input.Severity + " pest/disease report: " + plan.Plan_Name + ". Village: " + farmerRec.Village);
										resp = invokeurl
										[
											url :"https://cliq.zoho.in/api/v2/channelsbyname/agrocare/message"
											type :POST
											parameters:payload.toString()
											connection:"zoho_oauth_connection"
										];
										info resp;
						)
					}
				}

			}
			Advice_Follow_Up as "Advice Follow Up"
			{
				type =  form
				form = Officer_Advice

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											farmerRec = Farmer[ID == input.Farmer];
										// update the linked report or request
										if(input.Pest_Disease_Report != null)
										{
											rep = Pest_Disease_Report[ID == input.Pest_Disease_Report];
											rep.Status="Advisory Given";
										}
										if(input.Farmer_Request != null)
										{
											req = Farmer_Request[ID == input.Farmer_Request];
											req.Status="Issued";
										}
										// create an alert for the farmer
										insert into Alert
										[
											Farmer=input.Farmer
											Alert_Type="General"
											Severity="Info"
											Title="Officer advice received"
											Message=input.Advice
											Alert_Date=zoho.currenttime
											Added_User=zoho.loginuser
										]
										// email the farmer
										if(farmerRec.Login_Email != null && farmerRec.Login_Email != "")
										{
											sendmail
											[
												from :zoho.adminuserid
												to :farmerRec.Login_Email
												subject :"AgroCare: advice from " + input.Officer_Name
												message :"Advice: " + input.Advice + "<br>Please log in to AgroCare for the full action list."
											]
										}
						)
					}
				}

			}
			Fill_Inventory_Item_Name as "Fill Inventory Item Name"
			{
				type =  form
				form = Inventory

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Item_Type == "Seed" && input.Seed != null)
										{
											seedRec = Seed_Master[ID == input.Seed];
											input.Item_Name = seedRec.Seed_Name;
										}
										else if(input.Item_Type == "Fertilizer" && input.Fertilizer != null)
										{
											fertRec = Fertilizer_Master[ID == input.Fertilizer];
											input.Item_Name = fertRec.Fertilizer_Name;
										}
						)
					}
				}

			}
			Soil_PH_Check as "Soil PH Check"
			{
				type =  form
				form = Soil_Type

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Min_PH > input.Max_PH)
										{
											alert "Min pH cannot be greater than Max pH";
											cancel submit;
										}
										if(input.Min_PH < 0 || input.Max_PH > 14)
										{
											alert "pH must be between 0 and 14";
											cancel submit;
										}
						)
					}
				}

			}
			Crop_PH_Check as "Crop PH Check"
			{
				type =  form
				form = Crop

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Min_PH > input.Max_PH)
										{
											alert "Min pH cannot be greater than Max pH";
											cancel submit;
										}
										if(input.Min_PH < 0 || input.Max_PH > 14)
										{
											alert "pH must be between 0 and 14";
											cancel submit;
										}
						)
					}
				}

			}
			Recommended_Crops as "Recommended Crops"
			{
				type =  form
				form = Crop_Recommendation

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											plot = Farm_Plot[ID == input.Plot];
										soilRec = Soil_Type[ID == plot.Soil_Type];
										input.Soil_PH = plot.Soil_PH;
										input.Water_Availability = plot.Water_Availability;
										Soil_Type_Name = soilRec.Soil_Name;
										// water levels as numbers so we can compare how close they are
										waterLevel = Map();
										waterLevel.put("Low",1);
										waterLevel.put("Medium",2);
										waterLevel.put("High",3);
										plotWater = waterLevel.get(plot.Water_Availability);
										scoreMap = Map();
										nameList = List();
										for each  c in Crop[ID != 0]
										{
											score = 0;
											// Soil (35)
											if(c.Suitable_Soils.contains(plot.Soil_Type))
											{
												score = score + 35;
											}
											// Season (30)
											if(c.Season == input.Season)
											{
												score = score + 30;
											}
											// Water (20)
											cropWater = waterLevel.get(c.Water_Need);
											diff = plotWater - cropWater;
											if(diff < 0)
											{
												diff = 0 - diff;
											}
											if(diff == 0)
											{
												score = score + 20;
											}
											else if(diff == 1)
											{
												score = score + 10;
											}
											// pH (15)
											if(plot.Soil_PH >= c.Min_PH && plot.Soil_PH <= c.Max_PH)
											{
												score = score + 15;
											}
											else if(plot.Soil_PH >= c.Min_PH - 0.5 && plot.Soil_PH <= c.Max_PH + 0.5)
											{
												score = score + 7;
											}
											if(score >= 40)
											{
												scoreMap.put(c.Crop_Name,score);
												nameList.add(c.Crop_Name);
											}
										}
										// sort crops by score, highest first
										sorted = List();
										used = List();
										for each  pass in nameList
										{
											bestName = "";
											bestScore = -1;
											for each  n in nameList
											{
												if(!used.contains(n) && scoreMap.get(n) > bestScore)
												{
													bestName = n;
													bestScore = scoreMap.get(n);
												}
											}
											if(bestName != "")
											{
												sorted.add(bestName);
												used.add(bestName);
											}
										}
										// write results
										input.Recommendation_Results.clear();
										rank = 1;
										summary = "";
										for each  nm in sorted
										{
											row = Crop_Recommendation.Recommendation_Results();
											row.Crop_Name=nm;
											row.Score=scoreMap.get(nm);
											row.Rank=rank;
											input.Recommendation_Results.insert(row);
											if(summary != "")
											{
												summary = summary + ", ";
											}
											summary = summary + nm + " (" + scoreMap.get(nm) + "/100)";
											rank = rank + 1;
										}
										if(summary == "")
										{
											summary = "No suitable crop found. Try another season or contact an agricultural officer.";
										}
										input.Recommended_Crops = summary;
										input.Match_Count = sorted.size();
						)
					}
				}

			}
			Approve_Request_and_Deduc as "Approve Request and Deduct Stock"
			{
				type =  form
				form = Farmer_Request

				record event = on edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											if(input.Status == "Approved" && input.Stock_Deducted != "Yes")
										{
											// Pass 1: check there is enough stock for every row
											enough = true;
											for each  row in input.Request_Items
											{
												available = 0.0;
												if(row.Item_Type == "Seed" && row.Seed != null)
												{
													for each  inv in Inventory[Seed == row.Seed]
													{
														available = available + inv.Current_Stock;
													}
													if(available < row.Quantity)
													{
														enough = false;
													}
												}
												else if(row.Item_Type == "Fertilizer" && row.Fertilizer != null)
												{
													for each  inv2 in Inventory[Fertilizer == row.Fertilizer]
													{
														available = available + inv2.Current_Stock;
													}
													if(available < row.Quantity)
													{
														enough = false;
													}
												}
											}
											reqRec = Farmer_Request[ID == input.ID];
											if(enough)
											{
												// Pass 2: deduct the stock
												for each  row in input.Request_Items
												{
													if(row.Item_Type == "Seed" && row.Seed != null)
													{
														for each  inv3 in Inventory[Seed == row.Seed]
														{
															inv3.Current_Stock=inv3.Current_Stock - row.Quantity;
														}
													}
													else if(row.Item_Type == "Fertilizer" && row.Fertilizer != null)
													{
														for each  inv4 in Inventory[Fertilizer == row.Fertilizer]
														{
															inv4.Current_Stock=inv4.Current_Stock - row.Quantity;
														}
													}
												}
												reqRec.Stock_Deducted="Yes";
												reqRec.Approved_By=zoho.loginuser;
												reqRec.Approved_Date=zoho.currentdate;
											}
											else
											{
												reqRec.Status="Out of Stock";
											}
										}
						)
					}
				}

			}
			Low_Stock_Alert as "Low Stock Alert"
			{
				type =  form
				form = Inventory

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											if(input.Current_Stock <= input.Reorder_Level)
										{
											insert into Alert
											[
												Alert_Type="Low Stock"
												Severity="Warning"
												Title="Low stock: " + input.Item_Name
												Message=input.Item_Name + " stock is " + input.Current_Stock + " (reorder level " + input.Reorder_Level + "). Please restock."
												Alert_Date=zoho.currenttime
												Added_User=zoho.loginuser
											]
											sendmail
											[
												from :zoho.adminuserid
												to :"store@yourorg.com"
												subject :"Low stock: " + input.Item_Name
												message :input.Item_Name + " is at " + input.Current_Stock + ". Reorder level is " + input.Reorder_Level + "."
											]
										}
						)
					}
				}

			}
			Weather_Advisory1 as "Weather Advisory"
			{
				type =  form
				form = Weather_Update

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											created = 0;
										farmers = Farmer[Village == input.Village && Status == "Active"];
										for each  f in farmers
										{
											// 1. rain advisory
											if(input.Weather_Condition == "Heavy Rain")
											{
												insert into Alert
												[
													Farmer=f.ID
													Alert_Type="Weather"
													Severity="Critical"
													Title="Heavy rain expected"
													Message="Heavy rain expected in " + input.Village + ". Postpone irrigation and fertilizer application."
													Alert_Date=zoho.currenttime
													Added_User=zoho.loginuser
												]
												created = created + 1;
											}
											// 2. disease risk for each active crop of this farmer
											for each  cp in Crop_Plan[Farmer == f.ID && Status == "Sown" || Status == "Growing"]
											{
												for each  d in Disease_Master[Crop == cp.Crop]
												{
													if(input.Temperature >= d.Min_Temp && input.Temperature <= d.Max_Temp && input.Humidity >= d.Min_Humidity)
													{
														insert into Alert
														[
															Farmer=f.ID
															Crop_Plan=cp.ID
															Disease=d.ID
															Alert_Type="Disease Risk"
															Severity="Warning"
															Title=d.Disease_Name + " risk high"
															Message="High humidity (" + input.Humidity + "%) and temperature (" + input.Temperature + " C) may increase " + d.Disease_Name + " risk. Suggested action: " + d.Treatment
															Temperature=input.Temperature
															Humidity=input.Humidity
															Alert_Date=zoho.currenttime
															Added_User=zoho.loginuser
														]
														created = created + 1;
													}
												}
											}
											// 3. hot weather advisory
											if(input.Weather_Condition == "Hot" || input.Temperature >= 38)
											{
												insert into Alert
												[
													Farmer=f.ID
													Alert_Type="Weather"
													Severity="Warning"
													Title="High temperature"
													Message="Very hot weather in " + input.Village + ". Irrigate in the early morning or evening."
													Alert_Date=zoho.currenttime
													Added_User=zoho.loginuser
												]
												created = created + 1;
											}
										}
										upd = Weather_Update[ID == input.ID];
										upd.Alerts_Created=created;
						)
					}
				}

			}
		}

		schedule
		{
			Daily_Weather_and_Disease as "Daily Weather and Disease Check"
			{
				type =  schedule
					status = inactive
				start = "2026-10-18 06:00:00"
				frequency = daily
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
					on load
					(
						// ---------- 1. LOW STOCK CHECK ----------
										for each  inv in Inventory[ID != 0]
										{
											if(inv.Current_Stock <= inv.Reorder_Level)
											{
												lowTitle = "Low stock: " + inv.Item_Name;
												lowExisting = Alert[Alert_Type == "Low Stock" && Title == lowTitle];
												if(lowExisting.count() == 0)
												{
													insert into Alert
													[
														Alert_Type="Low Stock"
														Severity="Warning"
														Title=lowTitle
														Message=inv.Item_Name + " stock is " + inv.Current_Stock + " (reorder level " + inv.Reorder_Level + "). Please restock."
														Alert_Date=zoho.currenttime
														Added_User=zoho.loginuser
													]
												}
											}
										}
										// ---------- 2. HEALTH SCORE FOR ACTIVE CROP PLANS ----------
										for each  plan in Crop_Plan[Status == "Sown" || Status == "Growing"]
										{
											hs = 0;
											irr = Irrigation_Log[Crop_Plan == plan.ID && Irrigation_Date >= zoho.currentdate.subDay(7)];
											if(irr.count() > 0)
											{
												hs = hs + 25;
											}
											fer = Fertilizer_Usage[Crop_Plan == plan.ID && Application_Date >= zoho.currentdate.subDay(30)];
											if(fer.count() > 0)
											{
												hs = hs + 20;
											}
											openRep = Pest_Disease_Report[Crop_Plan == plan.ID && Status != "Resolved"];
											if(openRep.count() == 0)
											{
												hs = hs + 25;
											}
											risk = Alert[Crop_Plan == plan.ID && Alert_Type == "Disease Risk" && Alert_Date >= zoho.currentdate.subDay(7)];
											if(risk.count() == 0)
											{
												hs = hs + 15;
											}
											goodLog = Crop_Health_Log[Crop_Plan == plan.ID && Health_Status == "Good" || Health_Status == "Excellent" && Log_Date >= zoho.currentdate.subDay(14)];
											if(goodLog.count() > 0)
											{
												hs = hs + 15;
											}
											rating = "Poor";
											if(hs >= 85)
											{
												rating = "Excellent";
											}
											else if(hs >= 65)
											{
												rating = "Good";
											}
											else if(hs >= 45)
											{
												rating = "Fair";
											}
											cp2 = Crop_Plan[ID == plan.ID];
											cp2.Health_Score=hs;
											cp2.Health_Rating=rating;
										}
										// ---------- 3. IRRIGATION REMINDERS ----------
										for each  irrLog in Irrigation_Log[Next_Irrigation_Date != null && Next_Irrigation_Date <= zoho.currentdate]
										{
											irrPlan = Crop_Plan[ID == irrLog.Crop_Plan];
											irrFarmer = Farmer[ID == irrLog.Farmer];
											irrTitle = "Irrigation due: " + irrPlan.Plan_Name;
											irrExisting = Alert[Alert_Type == "Irrigation" && Title == irrTitle && Alert_Date >= zoho.currentdate];
											if(irrExisting.count() == 0)
											{
												insert into Alert
												[
													Farmer=irrLog.Farmer
													Crop_Plan=irrLog.Crop_Plan
													Alert_Type="Irrigation"
													Severity="Info"
													Title=irrTitle
													Message="Irrigation is due for your crop. Please irrigate and update the irrigation log."
													Alert_Date=zoho.currenttime
													Added_User=zoho.loginuser
												]
												if(irrFarmer.Login_Email != null && irrFarmer.Login_Email != "")
												{
													sendmail
													[
														from :zoho.loginuserid
														to :irrFarmer.Login_Email
														subject :"AgroCare reminder: irrigation due"
														message :"Irrigation is due for " + irrPlan.Plan_Name + ". Please irrigate and update the log."
													]
												}
											}
										}
										// ---------- 4. FERTILIZER REMINDERS ----------
										for each  fertLog in Fertilizer_Usage[Next_Application_Date != null && Next_Application_Date <= zoho.currentdate]
										{
											fertPlan = Crop_Plan[ID == fertLog.Crop_Plan];
											fertFarmer = Farmer[ID == fertLog.Farmer];
											fertTitle = "Fertilizer due: " + fertPlan.Plan_Name;
											fertExisting = Alert[Alert_Type == "General" && Title == fertTitle && Alert_Date >= zoho.currentdate];
											if(fertExisting.count() == 0)
											{
												insert into Alert
												[
													Farmer=fertLog.Farmer
													Crop_Plan=fertLog.Crop_Plan
													Alert_Type="General"
													Severity="Info"
													Title=fertTitle
													Message="The next fertilizer application is due. Please apply and update the usage log."
													Alert_Date=zoho.currenttime
													Added_User=zoho.loginuser
												]
												if(fertFarmer.Login_Email != null && fertFarmer.Login_Email != "")
												{
													sendmail
													[
														from :zoho.loginuserid
														to :fertFarmer.Login_Email
														subject :"AgroCare reminder: fertilizer due"
														message :"The next fertilizer application is due for " + fertPlan.Plan_Name + ". Please apply and update the log."
													]
												}
											}
										}
										// ---------- 5. COMMUNITY EARLY WARNING ----------
										doneKeys = List();
										recentReports = Pest_Disease_Report[Report_Date >= zoho.currentdate.subDay(7) && Status != "Resolved" && Suspected_Disease != null];
										for each  r in recentReports
										{
											rFarmer = Farmer[ID == r.Farmer];
											village = rFarmer.Village;
											key = r.Suspected_Disease + "|" + village;
											if(!doneKeys.contains(key))
											{
												doneKeys.add(key);
												cnt = 0;
												for each  r2 in recentReports
												{
													r2Farmer = Farmer[ID == r2.Farmer];
													if(r2.Suspected_Disease == r.Suspected_Disease && r2Farmer.Village == village)
													{
														cnt = cnt + 1;
													}
												}
												if(cnt >= 3)
												{
													disease = Disease_Master[ID == r.Suspected_Disease];
													warnTitle = "Community warning: " + disease.Disease_Name + " in " + village;
													for each  f in Farmer[Village == village && Status == "Active"]
													{
														warnExisting = Alert[Farmer == f.ID && Title == warnTitle && Alert_Date >= zoho.currentdate];
														if(warnExisting.count() == 0)
														{
															insert into Alert
															[
																Farmer=f.ID
																Alert_Type="Disease Risk"
																Severity="Critical"
																Risk_Level="High"
																Title=warnTitle
																Message=cnt + " farmers in " + village + " reported " + disease.Disease_Name + " this week. Inspect your crop and take preventive action: " + disease.Treatment
																Alert_Date=zoho.currenttime
																Added_User=zoho.loginuser
															]
															if(f.Login_Email != null && f.Login_Email != "")
															{
																sendmail
																[
																	from :zoho.loginuserid
																	to :f.Login_Email
																	subject :"AgroCare early warning: " + disease.Disease_Name
																	message :cnt + " farmers in " + village + " reported " + disease.Disease_Name + ". Please inspect your crop. Suggested action: " + disease.Treatment
																]
															}
														}
													}
												}
											}
										}
					)
					}
				}
			}
		}




	}
